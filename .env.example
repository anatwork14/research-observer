# Observaire local environment

# Optional embedded Codex switch/model.
# RESEARCH_OBSERVER_CODEX=1
# RESEARCH_OBSERVER_CODEX_MODEL=

# Optional TexLab language intelligence for the LaTeX IDE.
# TexLab is advisory only; latexmk/compiler diagnostics remain authoritative.
# Set RESEARCH_OBSERVER_TEXLAB=0 to disable probing entirely.
# Set OBSERVAIRE_TEXLAB_BIN when texlab is not available on PATH.
# RESEARCH_OBSERVER_TEXLAB=1
# OBSERVAIRE_TEXLAB_BIN=/absolute/path/to/texlab

# In-app Codex device authorization is enabled automatically in local development.
# Production remains off unless explicitly enabled.
# OBSERVAIRE_CODEX_AUTH_UI=0

# Consensus scholarly search.
# You can either set this server environment variable or save a key from Settings.
# Environment configuration takes precedence over the git-ignored workspace settings file.
CONSENSUS_API_KEY=

# Development/test only. Production ignores this and always uses
# https://api.consensus.app so the API key cannot be redirected by config.
# CONSENSUS_API_BASE_URL=http://127.0.0.1:8787

# Settings writes (for workspace-stored integration credentials) are local-development by default.
# Production remains read-only unless explicitly enabled.
# OBSERVAIRE_SETTINGS_WRITES=0

# Evidence capture, Direct Edit, project import, and the local orchestration editor are
# local-development writes by default. Set explicitly only if you intentionally enable
# these research/config writes while running a production build locally.
# This legacy key is preserved for compatibility with existing local write workflows.
# RESEARCH_OBSERVER_WRITES=0

# Health > Local workspace can rebuild disposable research artifacts and the local PDF.js runtime.
# Development enables these maintenance actions automatically. If you run a production build locally
# with `npm run build && npm start`, opt in explicitly without enabling other research writes.
# OBSERVAIRE_LOCAL_MAINTENANCE=0
