# Observaire local environment

# Optional embedded Codex switch/model.
# RESEARCH_OBSERVER_CODEX=1
# RESEARCH_OBSERVER_CODEX_MODEL=

# In-app Codex device authorization is enabled automatically in local development.
# Production remains off unless explicitly enabled.
# OBSERVAIRE_CODEX_AUTH_UI=0

# Consensus scholarly search.
# You can either set this server environment variable or save a key from Settings.
# Environment configuration takes precedence over the git-ignored workspace settings file.
CONSENSUS_API_KEY=

# Development/test only. Production ignores this and always uses
# https://api.consensus.app so the API key cannot be redirected by config.
# CONSENSUS_API_BASE_URL=http://127.0.0.1:8787

# Settings writes (for workspace-stored integration credentials) are local-development by default.
# Production remains read-only unless explicitly enabled.
# OBSERVAIRE_SETTINGS_WRITES=0

# Evidence capture and Direct Edit writes are local-development by default.
# Set explicitly only if you intentionally enable production writes.
# This legacy key is preserved for compatibility with existing deployments.
# RESEARCH_OBSERVER_WRITES=0
