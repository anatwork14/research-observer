# Research Observer local environment

# Optional embedded Codex switch/model.
# RESEARCH_OBSERVER_CODEX=1
# RESEARCH_OBSERVER_CODEX_MODEL=

# Consensus scholarly search.
# Create a key in the Consensus API & MCP dashboard.
CONSENSUS_API_KEY=

# Development/test only. Production ignores this and always uses
# https://api.consensus.app so the API key cannot be redirected by config.
# CONSENSUS_API_BASE_URL=http://127.0.0.1:8787

# Evidence writes are local-development by default.
# Set explicitly only if you intentionally enable production writes.
# RESEARCH_OBSERVER_WRITES=0
