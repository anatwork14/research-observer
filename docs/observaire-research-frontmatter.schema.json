{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observaire.local/schema/research-frontmatter-v1.json",
  "title": "Observaire AI-authored research frontmatter",
  "description": "Machine-readable core shape for new durable Observaire research objects. research-observer.config.json remains authoritative for evolving vocabularies such as type, status, relationship type, and project IDs.",
  "type": "object",
  "required": ["id", "title", "summary", "type"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1, "description": "Must be allowed by research-observer.config.json." },
    "status": { "type": "string", "minLength": 1, "description": "Must be allowed by research-observer.config.json." },
    "research": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "description": "Must name a configured research project; omit for default." },
    "date": { "type": "string", "format": "date" },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "authors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "year": { "type": "integer", "minimum": 1000, "maximum": 9999 },
    "doi": { "type": "string", "minLength": 1 },
    "pdf": { "type": "string", "minLength": 1 },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "source": { "$ref": "#/$defs/source" },
    "evaluationPlan": { "$ref": "#/$defs/evaluationPlan" },
    "experimentSpec": { "$ref": "#/$defs/experimentSpec" }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "required": ["id", "label", "role", "direction", "unit", "aggregation", "display", "aliases"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "role": { "enum": ["primary", "secondary", "guardrail", "diagnostic"] },
        "direction": { "enum": ["maximize", "minimize", "target"] },
        "unit": { "type": "string", "minLength": 1 },
        "aggregation": { "enum": ["mean", "median", "sum", "min", "max", "count", "last", "first", "none"] },
        "display": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "threshold": {},
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evaluationPlan": {
      "type": "object",
      "required": ["schemaVersion", "metrics", "comparisons", "ablations", "successCriteria"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } },
        "comparisons": { "type": "array", "items": { "type": "object" } },
        "ablations": { "type": "array", "items": { "type": "object" } },
        "successCriteria": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "experimentSpec": {
      "type": "object",
      "required": ["schemaVersion", "evaluationPlan", "kind", "factors", "controlledVariables"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "evaluationPlan": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "factors": { "type": "array", "items": { "type": "object" } },
        "controlledVariables": { "type": "array", "items": { "type": "string" } },
        "datasets": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": ["type", "target"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "description": "Must be allowed by research-observer.config.json." },
        "target": { "type": "string", "minLength": 1, "description": "Prefer an existing target stable ID." },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "pdf", "page"],
          "properties": {
            "kind": { "const": "pdf" },
            "pdf": { "type": "string", "minLength": 1 },
            "page": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "consensus" },
            "url": { "type": "string", "pattern": "^https://" },
            "doi": { "type": "string", "minLength": 1 },
            "paper_id": { "type": "string", "minLength": 1 },
            "query": { "type": "string" }
          },
          "anyOf": [
            { "required": ["url"] },
            { "required": ["doi"] },
            { "required": ["paper_id"] }
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
