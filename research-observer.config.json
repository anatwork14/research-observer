{
  "schemaVersion": 1,
  "progressDir": "progress",
  "warnOnMissingId": true,
  "allowedTypes": [
    "note",
    "question",
    "hypothesis",
    "literature",
    "method",
    "dataset",
    "experiment",
    "result",
    "decision",
    "milestone"
