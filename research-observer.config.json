    ".webp",
    ".avif",
    ".svg",
    ".bmp",
    ".pdf",
    ".mp4",
    ".webm",
    ".ogv",
    ".ogg",
    ".mp3",
    ".wav",
    ".m4a",
    ".aac",
    ".flac",
    ".csv",
    ".json",
    ".txt"
