{
  "name": "research-observer",
  "version": "2.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "predev": "npm run research:compile",
    "dev": "next dev",
    "prebuild": "npm run research:compile",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "research:compile": "node scripts/compile-research.mjs",
    "doctor": "node scripts/research-doctor.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run doctor && npm run test && npm run typecheck && npm run lint",
    "check:full": "npm run check && npm run build"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "next": "16.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "eslint": "9.0.0",
    "eslint-config-next": "16.3.3",
    "typescript": "5.9.0",
    "@types/node": "24.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0"
  }
}
