{
  "name": "observaire",
  "version": "2.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "dev": "node scripts/dev-research.mjs",
    "observaire:prepare": "node scripts/prepare-observaire-dirs.mjs",
    "observaire:prepare-volume": "node scripts/prepare-observaire-volume.mjs",
    "observaire:start": "npm run observaire:prepare && npm run observaire:prepare-volume && docker compose up -d",
    "observaire:start:build": "npm run observaire:prepare && npm run observaire:prepare-volume && docker compose up -d --build",
    "observaire:stop": "docker compose down",
    "observaire:restart": "docker compose restart",
    "observaire:logs": "docker compose logs -f --tail=100",
    "observaire:status": "docker compose ps",
    "prebuild": "npm run research:prepare-pdf && npm run research:compile",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --config eslint.config.mjs .",
    "typecheck": "tsc --noEmit",
    "research:compile": "node scripts/compile-research.mjs",
    "research:prepare-pdf": "node scripts/prepare-pdf-runtime.mjs",
    "verify:workflow": "node --test tests/research-manuscript-flow.test.mjs",
    "verify:persistence": "node scripts/verify-compose-persistence.mjs",
    "verify:merge-local": "npm run check:full && npm run verify:workflow",
    "verify:merge-full": "npm run verify:merge-local && npm run verify:latex:container && npm run verify:latex:project-toolchain && npm run verify:latex:project-app && npm run verify:persistence",
    "verify:latex": "node scripts/verify-latex-toolchain.mjs",
    "verify:latex:container": "node scripts/verify-latex-container.mjs",
    "verify:latex:project-toolchain": "docker build --target latex-toolchain -t observaire-latex-toolchain .",
    "verify:latex:project-app": "node scripts/verify-latex-project-app.mjs",
    "doctor": "node scripts/research-doctor.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run doctor && npm run test && npm run typecheck && npm run lint",
    "check:full": "npm run check && npm run build"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "react-pdf": "11.0.0",
    "pdfjs-dist": "6.3.289",
    "@openai/codex-sdk": "0.155.1",
    "@openai/codex": "0.155.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/view": "^6.43.13",
    "@codemirror/legacy-modes": "^6.5.4",
    "@uiw/react-codemirror": "^4.25.12"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "5.9.3",
    "@types/node": "24.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0"
  }
}
